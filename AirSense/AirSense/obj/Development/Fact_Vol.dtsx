public class UserComponent: ScriptComponent
{
    public Connections Connections;
    public Variables Variables;
    public UserComponent()
    {
        Connections = new Connections(this);
        Variables = new Variables(this);
    }

    public override void ProcessInput(int InputID, string InputName, PipelineBuffer Buffer, OutputNameMap OutputMap)
    {

        if (InputName.Equals(@"distance_clean", StringComparison.Ordinal))
        {
            distanceclean_ProcessInput(new distancecleanBuffer(Buffer, GetColumnIndexes(InputID), OutputMap));
        }

    }

    public virtual void distanceclean_ProcessInput(distancecleanBuffer Buffer)
    {
        while (Buffer.NextRow())
        {
            distanceclean_ProcessInputRow(Buffer);
        }
    }

    public virtual void distanceclean_ProcessInputRow(distancecleanBuffer Row)
    {
    }

}

public class Connections
{
    ScriptComponent ParentComponent;

    public Connections(ScriptComponent Component)
    {
        ParentComponent = Component;
    }

}

public class Variables
{
    ScriptComponent ParentComponent;

    public Variables(ScriptComponent Component)
    {
        ParentComponent = Component;
    }

}
