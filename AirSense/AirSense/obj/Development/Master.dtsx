    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A10DA7D9-2817-4061-8855-88BF9EE1695B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6EBD6C21-59F4-4B66-94E0-D1D7A6345A8F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;-- FACT tables&#xA;IF OBJECT_ID('dbo.Fact_Vol', 'U')          IS NOT NULL DELETE FROM Fact_Vol;&#xA;IF OBJECT_ID('dbo.Fact_Incident', 'U')     IS NOT NULL DELETE FROM Fact_Incident;&#xA;--IF OBJECT_ID('dbo.FactPerformance', 'U')  IS NOT NULL DELETE FROM FactPerformance;&#xA;&#xA;-- DIM children&#xA;IF OBJECT_ID('dbo.Aeroport', 'U')         IS NOT NULL &#xA;BEGIN&#xA;    ALTER TABLE Aeroport NOCHECK CONSTRAINT ALL;&#xA;    DELETE FROM Aeroport;&#xA;    ALTER TABLE Aeroport CHECK CONSTRAINT ALL;&#xA;END&#xA;&#xA;IF OBJECT_ID('dbo.Compagnie', 'U')        IS NOT NULL &#xA;BEGIN&#xA;    ALTER TABLE Compagnie NOCHECK CONSTRAINT ALL;&#xA;    DELETE FROM Compagnie;&#xA;    ALTER TABLE Compagnie CHECK CONSTRAINT ALL;&#xA;END&#xA;&#xA;IF OBJECT_ID('dbo.Temps', 'U')            IS NOT NULL DELETE FROM Temps;&#xA;IF OBJECT_ID('dbo.Meteo', 'U')            IS NOT NULL DELETE FROM Meteo;&#xA;IF OBJECT_ID('dbo.CauseRetard', 'U')      IS NOT NULL DELETE FROM CauseRetard;&#xA;IF OBJECT_ID('dbo.TypeIncident', 'U')     IS NOT NULL DELETE FROM TypeIncident;&#xA;&#xA;-- DIM parents&#xA;IF OBJECT_ID('dbo.Taille', 'U')           IS NOT NULL DELETE FROM Taille;&#xA;IF OBJECT_ID('dbo.Pays', 'U')             IS NOT NULL DELETE FROM Pays;&#xA;&#xA;-- Reset IDENTITY only if table exists and has identity&#xA;IF OBJECT_ID('dbo.Pays', 'U')             IS NOT NULL DBCC CHECKIDENT ('Pays',   RESEED, 0);&#xA;IF OBJECT_ID('dbo.Taille', 'U')           IS NOT NULL DBCC CHECKIDENT ('Taille', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
